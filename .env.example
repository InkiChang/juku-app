# Optional override. Leave empty to use the Vite development proxy.
VITE_API_BASE_URL=

# Optional production default. Keep deployment-specific values in .env.local.
# VITE_PRODUCTION_API_BASE_URL=https://your-backend.example

# Optional Vite development proxy targets. These are never committed with real
# deployment addresses; set them in .env.local when needed.
# JUKU_DEV_LOCAL_API_BASE_URL=http://localhost:8998
# JUKU_DEV_REMOTE_API_BASE_URL=https://your-backend.example
